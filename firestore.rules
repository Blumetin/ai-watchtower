rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /alerts/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /history/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /earthquakes/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /meta/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
